      },
      "children": [],
      "content_layer": "body",
      "label": "formula",
      "prov": [],
      "orig": "\\mbox{KL}(y~||~\\hat{y})\n= \\sum_i y_i \\log \\frac{1}{\\hat{y}_i} - \\sum_i y_i \\log \\frac{1}{y_i}\n= \\sum_i y_i \\log \\frac{y_i}{\\hat{y}_i}",
      "text": "\\mbox{KL}(y~||~\\hat{y})\n= \\sum_i y_i \\log \\frac{1}{\\hat{y}_i} - \\sum_i y_i \\log \\frac{1}{y_i}\n= \\sum_i y_i \\log \\frac{y_i}{\\hat{y}_i}"
    },
